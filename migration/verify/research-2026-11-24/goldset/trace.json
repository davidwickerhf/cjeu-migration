  "ECLI:EU:C:2013:720": {
   "id": "ECLI:EU:C:2013:720",
   "lane": "eu",
   "court": "EU Court of Justice",
   "name": "X, Y and Z",
   "short": "X, Y and Z",
   "date": "2013-11-07",
   "ecli": "ECLI:EU:C:2013:720",
   "celex": "62012CJ0199",
   "caseno": "C-199/12, C-200/12, C-201/12 (joined)",
   "appno": "",
   "url": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:62012CJ0199",
   "summary": "Gay people can form a 'particular social group'; criminalising homosexual acts is not persecution in itself, but prison sentences that are actually applied are; and asylum seekers cannot be expected to hide their sexual orientation or be discreet to avoid persecution.",
   "aliases": []
  },
