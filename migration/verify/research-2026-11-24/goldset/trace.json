{
 "docs": {
  "ECLI:EU:C:2019:189": {
   "id": "ECLI:EU:C:2019:189",
   "lane": "eu",
   "court": "EU Court of Justice",
   "name": "Tjebbes and Others",
   "short": "Tjebbes",
   "date": "2019-03-12",
   "ecli": "ECLI:EU:C:2019:189",
   "celex": "62017CJ0221",
   "caseno": "C-221/17",
   "appno": "",
   "url": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:62017CJ0221",
   "summary": "EU law allows a Member State to provide for loss of nationality by operation of law, as long as authorities and courts can examine, case by case, whether the consequences of losing EU citizenship are proportionate and, if not, restore nationality retroactively.",
   "aliases": []
  },
  "ECLI:NL:RVS:2017:1098": {
   "id": "ECLI:NL:RVS:2017:1098",
   "lane": "nl",
   "court": "Raad van State",
   "name": "Raad van State, 19 April 2017 · referral",
   "short": "RvS 2017",
   "date": "2017-04-19",
   "ecli": "ECLI:NL:RVS:2017:1098",
   "celex": "",
   "caseno": "201504577/1/A3, 201507057/1/A3, 201508588/1/A3 en 201601993/1/A3",
   "appno": "",
   "url": "https://uitspraken.rechtspraak.nl/details?id=ECLI:NL:RVS:2017:1098",
   "summary": "The Council of State, hearing appeals by four women whose passport applications were refused because they had lost Dutch nationality, asks the CJEU whether that automatic loss is compatible with EU citizenship rules.",
   "aliases": []
  },
  "ECLI:NL:RVS:2020:423": {
   "id": "ECLI:NL:RVS:2020:423",
   "lane": "nl",
   "court": "Raad van State",
   "name": "Raad van State, 12 February 2020 · final judgment after the ruling",
   "short": "RvS 2020",
   "date": "2020-02-12",
   "ecli": "ECLI:NL:RVS:2020:423",
   "celex": "",
   "caseno": "201504577/2/A3, 201507057/2/A3, 201508588/2/A3, 201601993/2/A3, 201604943/1/A3 en 201608752/1/A3",
   "appno": "",
   "url": "https://uitspraken.rechtspraak.nl/details?id=ECLI:NL:RVS:2020:423",
   "summary": "After Tjebbes, the Council of State upholds the appeals, annuls the passport decisions and tells the Foreign Minister how to carry out the individual EU-law proportionality test (para. 11.2), ordering new decisions.",
   "aliases": []
  },
  "ECLI:NL:HR:2020:593": {
   "id": "ECLI:NL:HR:2020:593",
   "lane": "nl",
   "court": "Hoge Raad",
   "name": "Hoge Raad, 3 April 2020 · applies the ruling",
   "short": "HR 2020",
   "date": "2020-04-03",
   "ecli": "ECLI:NL:HR:2020:593",
   "celex": "",
   "caseno": "19/02010",
   "appno": "",
   "url": "https://uitspraken.rechtspraak.nl/details?id=ECLI:NL:HR:2020:593",
   "summary": "The Supreme Court holds that the Tjebbes proportionality test also applies in civil proceedings to establish Dutch nationality (art. 17 RWN), quashes the Hague District Court's decision and sends the case back.",
   "aliases": []
  },
  "ECLI:NL:HR:2022:637": {
   "id": "ECLI:NL:HR:2022:637",
