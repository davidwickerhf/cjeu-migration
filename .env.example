# Copy to .env and fill in. Loaded automatically via python-dotenv.

# Required for pushing the dataset to the HuggingFace Hub.
# Get one at https://huggingface.co/settings/tokens (needs write scope).
HUGGINGFACE_TOKEN=

# Target HF dataset repo (org_or_user / dataset_name).
HF_DATASET_REPO=maastrichtlawtech/cjeu-cases

# Local workspace for per-window CSV/JSON outputs + the manifest.
# Survives restarts — point at persistent storage on Vast.ai.
WORKSPACE_DIR=./workspace

# Date range. Defaults cover the full CJEU corpus (1954 → today).
# Set narrower bounds for testing.
START_DATE=1954-01-01
END_DATE=

# Window granularity. 'month' is the default; 'quarter' or 'year' also valid.
WINDOW=month

# Maximum number of ECLIs per get_cellar_extra call (safety cap).
MAX_ECLI_PER_WINDOW=10000

# Worker threads for cellar-extractor enrichment.
EXTRACTOR_THREADS=10

# Retries per window before giving up.
MAX_WINDOW_RETRIES=3

# Skip the HF upload step (useful for local-only dry runs).
SKIP_UPLOAD=0
